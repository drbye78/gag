# Engineering Intelligence System - Sample Configuration
# Copy this file to .env and customize for your environment
# This file demonstrates configuration capabilities (not all options required)

# ════════════════════════════════════════════════════════════════════════════
# REQUIRED SETTINGS - Must be configured for production
# ════════════════════════════════════════════════════════════════════════════

# JWT authentication - CHANGE THIS IN PRODUCTION
JWT_SECRET=<your-secure-random-secret-minimum-32-chars>
CREDENTIAL_ENCRYPT_KEY=<32-character-encryption-key>

# LLM provider (required for reasoning agents)
LLM_PROVIDER=openrouter
LLM_MODEL=qwen-max
LLM_API_KEY=<your-openrouter-api-key>

# ════════════════════════════════════════════════════════════════════════════
# DATABASE CONNECTIONS
# ════════════════════════════════════════════════════════════════════════════

# Qdrant (Vector DB) - Required for embedding search
QDRANT_HOST=localhost
QDRANT_PORT=6333

# FalkorDB (Knowledge Graph) - Required for graphRAG
FALKORDB_HOST=localhost
FALKORDB_PORT=7379
# FALKORDB_USER=
# FALKORDB_PASS=

# Redis (Distributed Cache) - Optional, falls back to in-memory
REDIS_URL=redis://localhost:6379

# ════════════════════════════════════════════════════════════════════════════
# EMBEDDINGS & RERANKING
# ════════════════════════════════════════════════════════════════════════════

# Embedding provider (openai, qwen, ollama, qdrant)
EMBEDDING_PROVIDER=openrouter
# OPENAI_API_KEY=
DASHSCOPE_API_KEY=<your-dashscope-key>

# Reranking
RERANK_PROVIDER=cohere
RERANK_TOP_K=10
# COHERE_API_KEY=

# ════════════════════════════════════════════════════════════════════════════
# RETRIEVAL CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════

# Default retrieval strategy (vector, graph, hybrid, cascade, iterative)
RETRIEVAL_DEFAULT_STRATEGY=hybrid

# Fusion method (rrf, score_normalized, weighted, combined)
RETRIEVAL_FUSION_METHOD=rrf

# Parallel source retrieval
RETRIEVAL_PARALLEL_RETRIEVAL=true
RETRIEVAL_TIMEOUT_SECONDS=30
RETRIEVAL_FALLBACK_ON_EMPTY=true

# Citation style (parenthetical, verbatim, footnote, highlight, structured)
CITATION_STYLE=parenthetical
CITATION_INCLUDE_SCORES=true

# ════════════════════════════════════════════════════════════════════════════
# CHUNKING PIPELINE
# ══════════════════════════���═════════════════════════════════════════════════

CHUNKING_CHUNKER_TYPE=semantic
CHUNKING_SEMANTIC_CHUNK_THRESHOLD=0.5
CHUNKING_SENTENCE_CHUNK_SIZE=1024
CHUNKING_CHUNK_MIN_LENGTH=50
CHUNKING_CHUNK_MAX_LENGTH=2048

# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL FEATURES
# ════════════════════════════════════════════════════════════════════════════

# ColBERT - Late interaction embeddings (requires GPU)
# COLBERT_ENABLED=true
# COLBERT_MODEL_NAME=colbert-ir/colbertv2.0

# Multimodal / VLM
VLM_PROVIDER=openrouter
VLM_MODEL=google/gemma-4-31b-it:free

# GraphRAG - Knowledge graph extraction
GRAPH_RAG_ENABLED=true
GRAPH_RAG_STRUCTURAL_CHUNKING=true
GRAPH_RAG_INCREMENTAL=true
GRAPH_RAG_COMMUNITY_DETECTION=true
GRAPH_RAG_MAX_ENTITIES=100

# Language detection (for multilingual documents)
# langdetect enabled by default

# ════════════════════════════════════════════════════════════════════════════
# AUTH / RBAC
# ════════════════════════════════════════════════════════════════════════════

JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# User store backend (sqlite, memory)
USER_STORE_BACKEND=sqlite

# ════════════════════════════════════════════════════════════════════════════
# API SERVER
# ════════════════════════════════════════════════════════════════════════════

API_HOST=0.0.0.0
API_PORT=8000

# CORS - Separate multiple origins with commas
# NOTE: Do NOT use * in production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

MAX_WORKERS=4
REQUEST_TIMEOUT=60

# ════════════════════════════════════════════════════════════════════════════
# LOGGING & DEBUG
# ════════════════════════════════════════════════════════════════════════════

DEBUG=false
LOG_LEVEL=INFO

# ════════════════════════════════════════════════════════════════════════════
# OBSERVABILITY
# ════════════════════════════════════════════════════════════════════════════

ENABLE_METRICS=true
ENABLE_TRACING=false

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true

# Prometheus remote write
# PROMETHEUS_URL=http://localhost:9090

# ═════════════════════════════════════════════��══════════════════════════════
# EXTERNAL INTEGRATIONS (Optional)
# ════════════════════════════════════════════════════════════════════════════

# Jira tickets
# JIRA_URL=https://your-company.atlassian.net
# JIRA_EMAIL=your-email@company.com
# JIRA_API_TOKEN=<your-jira-api-token>

# GitHub
# GITHUB_OWNER=your-org
# GITHUB_REPO=your-repo
# GITHUB_TOKEN=<your-github-token>

# Confluence
# CONFLUENCE_URL=https://your-company.atlassian.net/wiki
# CONFLUENCE_EMAIL=your-email@company.com
# CONFLUENCE_API_TOKEN=<your-confluence-api-token>

# Azure DevOps
# AZURE_DEVOPS_USERNAME=your-username
# AZURE_DEVOPS_TOKEN=<your-azure-devops-pat>

# Elasticsearch (log aggregation)
# ELASTIC_URL=http://localhost:9200
# ELASTIC_USER=
# ELASTIC_PASS=

# Loki (log aggregation)
# LOKI_URL=http://localhost:3100
# LOKI_TOKEN=<your-loki-token>